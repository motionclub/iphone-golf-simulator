+def _basalt_chart_normal(pts):
+    a, b = pts, np.roll(pts, -1, axis=0)
+    n = np.array([np.sum((a[:, 1] - b[:, 1]) * (a[:, 2] + b[:, 2])),
+                  np.sum((a[:, 2] - b[:, 2]) * (a[:, 0] + b[:, 0])),
+                  np.sum((a[:, 0] - b[:, 0]) * (a[:, 1] + b[:, 1]))])
+    return n / max(float(np.linalg.norm(n)), 1e-12)
+
