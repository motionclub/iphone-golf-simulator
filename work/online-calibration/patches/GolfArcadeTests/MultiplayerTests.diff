+    func testConnectionCheckRunsWhileCourtsLoadAndDoesNotAddAnotherSetupWait() throws {
+        let p = try party(2, linkCheck: true); defer { p.close() }
+        for service in p.services { try service.setReady(true) }; try p.host.startMatch()
