// Shared by RenderedSky, RenderedClouds and DistantScenery (work/rendered-backgrounds).
// Every value here is published each frame by RenderedSky.cs from the scene's real directional light.
#ifndef RENDERED_SKY_COMMON
#define RENDERED_SKY_COMMON

TEXTURE2D(_RSkyRayleigh); SAMPLER(sampler_RSkyRayleigh);   // in-scattered Rayleigh (phase applied), 48x48
TEXTURE2D(_RSkyMie);      SAMPLER(sampler_RSkyMie);        // in-scattered Mie, phase NOT applied
TEXTURE2D(_RSkyNoise);    SAMPLER(sampler_RSkyNoise);      // tileable fbm (R) + ridged (G), generated by us
float4 _RSkySunDir;      // xyz = direction TO the light (sun by day, moon at night), w = disc angular radius (rad)
float4 _RSkySunColor;    // rgb = light colour x intensity used for clouds/scenery, a = disc brightness
float4 _RSkyScatterDir;  // xyz = direction used for the scattering (glow), w = mie g
float4 _RSkyParams;      // x = exposure, y = night (0..1), z = overcast (0..1), w = time (s)
float4 _RSkyAerial;      // x = aerial-perspective e-folding distance (m), y = sea level (world y), z = haze lift, w = far-field start (fraction of far clip)
float4 _RSkyGrade;       // x = saturation (zenith), y = highlight knee, z = multiple-scattering lift (CPU only), w = haze scale height (m)
float4 _RSkyHorizonTint; // rgb = tint at the horizon, a = saturation at the horizon
float4 _RSkyAmbientUp;   // rgb = sky irradiance from above (for clouds/scenery)
float4 _RSkyAmbientHorizon; // rgb = sky colour at the horizon, azimuth average
float4 _RSkySea;         // rgb = deep sea colour, a = reflectance
float4 _RSkyNightTint;   // rgb = night base sky colour

float RS_LutV(float elevation)       // elevation (rad) -> v, sqrt spacing (dense at the horizon)
{
    float s = sign(elevation); float a = sqrt(saturate(abs(elevation) / 1.5707963));
    return .5 + .5 * s * a;
}

half3 RS_Grade(half3 c, float up)
{
    float k0 = smoothstep(0, .32, up);
    c *= lerp(_RSkyHorizonTint.rgb, 1, k0);
    half l = dot(c, half3(.2126, .7152, .0722));
    c = max(l + (c - l) * lerp(_RSkyHorizonTint.a, _RSkyGrade.x, k0), 0);
    half k = _RSkyGrade.y;   // soft knee: nothing in the sky clips to flat white
    return c < k ? c : k + (1 - k) * (1 - exp(-(c - k) / (1 - k)));
}

half3 RS_SkyNoSun(float3 d)
{
    float elev = asin(clamp(d.y, -1, 1));
    float2 h = d.xz; float2 sh = _RSkyScatterDir.xz;
    float hl = max(length(h), 1e-5), sl = max(length(sh), 1e-5);
    float cosAz = clamp(dot(h / hl, sh / sl), -1, 1);
    float2 uv = float2(acos(cosAz) / 3.14159265, RS_LutV(max(elev, .002)));
    half3 rayleigh = SAMPLE_TEXTURE2D_LOD(_RSkyRayleigh, sampler_RSkyRayleigh, uv, 0).rgb;
    half3 mie = SAMPLE_TEXTURE2D_LOD(_RSkyMie, sampler_RSkyMie, uv, 0).rgb;
    float mu = dot(d, _RSkyScatterDir.xyz), g = _RSkyScatterDir.w;
    float phaseM = 3.0 / (8.0 * 3.14159265) * ((1 - g * g) * (1 + mu * mu)) / ((2 + g * g) * pow(max(1 + g * g - 2 * g * mu, 1e-4), 1.5));
    half3 sky = RS_Grade((rayleigh + mie * phaseM) * _RSkyParams.x, d.y);
    // night: the scattered twilight is dimmed and laid over a deep blue base
    sky = lerp(sky, _RSkyNightTint.rgb * lerp(1.0, .35, saturate(d.y * 1.4)) + sky * .25, _RSkyParams.y);
    // overcast: towards a flat grey-blue lit by the same light
    half lum = dot(_RSkyAmbientHorizon.rgb, half3(.3, .55, .15));
    half3 grey = lerp(half3(.62, .66, .72), half3(.48, .53, .60), saturate(d.y)) * lum * 1.15;
    return lerp(sky, grey, _RSkyParams.z * .85);
}

// Aerial perspective for anything at true distance `dist` along `viewDir` (from the camera). The haze
// thins with height (scale height _RSkyGrade.w), so a cloud 1 km up is clearer than an island at the
// same distance on the sea.
half3 RS_Aerial(half3 color, float3 viewDir, float dist)
{
    float3 dh = viewDir; dh.y = max(dh.y, .015); dh = normalize(dh);
    half3 haze = RS_SkyNoSun(dh) * (1 + _RSkyAerial.z);
    float H = max(_RSkyGrade.w, 50), rise = max(viewDir.y * dist, 0);
    float density = rise > 1 ? H / rise * (1 - exp(-rise / H)) : 1;
    float t = 1 - exp(-dist * density / max(_RSkyAerial.x, 1));
    return lerp(color, haze, t);
}

// Far-field projection: keep the true direction from the camera (so true parallax and true screen
// position) but pull the vertex in along that direction so its depth fits inside the camera's
// far clip, monotonic in true distance. Things nearer than the start keep their real depth.
float3 RS_FarField(float3 positionWS, out float trueDistance)
{
    float3 toV = positionWS - _WorldSpaceCameraPos;
    trueDistance = length(toV);
    float far = _ProjectionParams.z;
    float start = far * _RSkyAerial.w, room = far * .985 - start;
    float d = trueDistance <= start ? trueDistance : start + room * (1 - exp(-(trueDistance - start) / (room * 6)));
    return _WorldSpaceCameraPos + toV / max(trueDistance, 1e-3) * d;
}
#endif
