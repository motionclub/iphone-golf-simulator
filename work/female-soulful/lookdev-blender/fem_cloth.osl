#include "hero_common.h"
// Port of TennisCloth with garment maps, _FabricVersion 2 (golf), _FemaleSurface 1/2.
// Mode 0 = clone before, Mode 1 = staged after. Golf studio profile, film response on.
float CHash(float px, float py) {
    vector h=vector(px*.1031,py*.1031,px*.1031); h=h-floor(h);
    float d=dot(h,vector(h[1],h[2],h[0])+33.33); h+=d; float r=(h[0]+h[1])*h[2]; return r-floor(r);
}
float CGrain(float px, float py) {
    float cx=floor(px), cy=floor(py), fx=px-cx, fy=py-cy; fx=fx*fx*(3-2*fx); fy=fy*fy*(3-2*fy);
    return mix(mix(CHash(cx,cy),CHash(cx+1,cy),fx),mix(CHash(cx,cy+1),CHash(cx+1,cy+1),fx),fy);
}
color Deep(color a) { float y=max(luma(a),.04); return satc(a*a/y); }
color ShadeBefore(vector l, color lc, vector n, vector v, color albedo, float smoothness, float sheen, float ao, float id, float wrap) {
    float nl=sat01(dot(n,l)), nv=sat01(dot(n,v));
    float wrapped=sat01((dot(n,l)+wrap)/(1+wrap));
    float nh=sat01(dot(n,snorm(l+v)));
    float rubber=(id>2.5&&id<4.5)?1:0;
    color fibreTint=mix(albedo,sqrt(max(albedo,color(0))),.28);
    float grazing=pow(1-nv,3)*(.30+.70*nl);
    color fuzz=fibreTint*sheen*grazing*.22*(1-rubber);
    float spec=pow(nh,18+smoothness*48)*mix(.010,.024,rubber)*nl;
    float diffuse=wrapped*(.91+.09*(1-nl)*(1-nv));
    return (albedo*diffuse+fuzz+spec)*ao*lc;
}
color ShadeAfter(vector l, color lc, vector n, vector v, color albedo, float smoothness, float sheen, float ao, float id, float wrap) {
    float ndl=dot(n,l), nl=sat01(ndl), nv=sat01(dot(n,v));
    float wrapped=sat01((ndl+wrap)/(1+wrap));
    float band=sat01(wrapped-nl);
    float nh=sat01(dot(n,snorm(l+v)));
    float rubber=(id>2.5&&id<4.5)?1:0;
    float invR=1.55;
    float charlie=(2+invR)*pow(max(1-nh*nh,.0001),invR*.5)*.15915494;
    float visib=1/max(4*(nl+nv-nl*nv),.10);
    color fibreTint=mix(albedo,sqrt(max(albedo,color(0))),.45);
    color velvet=fibreTint*(charlie*visib*nl*sheen*1.7)*(1-rubber);
    float spec=pow(nh,24+smoothness*60)*.035*nl*rubber;
    // Rounded knit volume: fibres turned from the viewer read deeper and richer.
    float body=mix(.74,1.0,sqrt(nv));
    color diffuse=(albedo*nl*.96+mix(albedo,Deep(albedo),.65)*band*.85*(1-rubber*.5))*mix(1,body,1-rubber);
    return (diffuse+velvet+spec)*ao*lc;
}
shader FemCloth(
    color BaseSRGB = color(0.910,0.482,0.396),
    color TrimSRGB = color(0.035,0.035,0.0401),
    int Mode = 0,
    float FemaleSurface = 1,
    float WeaveTile = 60,
    string MaskMap = "",
    string IdMap = "",
    string NormalMap = "",
    string Atlas = "",
    vector Tangent = vector(1,0,0),
    output closure color Out = 0)
{
    float uu=u, vv=v;
    color base=color(pow(BaseSRGB[0],2.2),pow(BaseSRGB[1],2.2),pow(BaseSRGB[2],2.2));
    color trim=color(pow(TrimSRGB[0],2.2),pow(TrimSRGB[1],2.2),pow(TrimSRGB[2],2.2));
    color m3=texture(MaskMap,uu,1-vv,"colorspace","Non-Color","interp","closest"); color mac=texture(IdMap,uu,1-vv,"colorspace","Non-Color","interp","closest"); float ma=mac[0];
    color nc=texture(NormalMap,uu,1-vv,"colorspace","Non-Color");
    float wrapP = Mode==0?.18:.30, weaveN = Mode==0?.10:.15, thread = Mode==0?.09:.11, nStr = Mode==0?.75:.80;
    float tile = WeaveTile*1.5;
    vector garment=vector(nc[0]*2-1,nc[1]*2-1,nc[2]*2-1); garment[0]*=nStr; garment[1]*=nStr;
    float id=floor(ma*9+.5);
    float smoothness=.10, shn=.55, knit=1, qx=0, qy=0, freq=8;
    if(id>.5&&id<1.5){smoothness=.13;shn=.38;qx=1;freq=12;}
    else if(id<2.5&&id>1.5){smoothness=.16;shn=.24;knit=0;qy=1;}
    else if(id<3.5&&id>2.5){smoothness=.04;shn=0;knit=0;qx=1;qy=1;}
    else if(id<4.5&&id>3.5){smoothness=.08;shn=0;knit=0;qx=1;qy=1;}
    else if(id>4.5){smoothness=.10;shn=.18;knit=0;qx=1;}
    if(id>5.5){
        if(id<6.5){smoothness=.09;shn=.24;knit=0;qx=0;qy=0;freq=8;}
        else if(id<7.5){smoothness=.12;shn=.32;knit=1;qx=1;qy=0;freq=10;}
        else if(id<8.5){smoothness=.18;shn=.10;knit=0;qx=0;qy=1;freq=8;}
        else {smoothness=.08;shn=.18;knit=0;qx=1;qy=1;freq=8;}
    }
    smoothness*=.65; shn*=.90;
    float wx=uu*tile, wy=vv*tile;
    float fw=max(filterwidth(wx),filterwidth(wy));
    float fade=1-smoothstepf(.32,.72,fw*freq);
    float ax=(qx+.03125+(wx-floor(wx))*.9375)*.5, ay=(qy+.03125+(wy-floor(wy))*.9375)*.5;
    color weave=texture(Atlas,ax,1-ay,"colorspace","Non-Color","blur",0.0);
    float cover = FemaleSurface>1.5 ? 1-m3[2] : 1;
    float sx=(weave[0]*2-1)*weaveN*fade*cover, sy=(weave[1]*2-1)*weaveN*fade*cover;
    if(FemaleSurface>1.5) shn*=cover;
    if(id>2.5&&id<4.5){sx=0;sy=0;}
    vector Nb=normalize(N), T=normalize(Tangent-dot(Tangent,Nb)*Nb), B=cross(Nb,T);
    vector ts=normalize(vector(garment[0]+sx,garment[1]+sy,garment[2]));
    vector nw=normalize(T*ts[0]+B*ts[1]+Nb*ts[2]);
    float threadBreak=mix(1,weave[2]*1.28,thread*fade*cover);
    if(id>2.5&&id<4.5)threadBreak=1;
    color albedo=mix(base,trim,m3[2])*threadBreak;
    if(!(id>2.5&&id<4.5)){
        float gx=wx*9, gy=wy*9;
        float gFade=1-smoothstepf(.35,.85,max(filterwidth(gx),filterwidth(gy)));
        float grain=CGrain(gx,gy)-.5;
        albedo*=1+grain*(Mode==0?.035:.05)*gFade*cover;
        smoothness*=1+grain*.25*gFade*cover;
    }
    float aoVis=mix(1,max(m3[0],.70),1.0);
    float ao=mix(1,aoVis,.5);
    albedo*=mix(Mode==0?.82:.88,1,m3[1]);
    vector n=toU(nw), vw=toU(-normalize(I));
    float ndv=sat01(dot(n,vw));
    vector ls[4]={LKey(),LFill(),LBack(),LPres(vw)};
    color cs[4]={CKey(),CFill(),CBack(),CPres()*(Mode==0?.65:.42)};
    color col=0;
    for(int k=0;k<4;k++) col+= Mode==0 ? ShadeBefore(ls[k],cs[k],n,vw,albedo,smoothness,shn,ao,id,wrapP) : ShadeAfter(ls[k],cs[k],n,vw,albedo,smoothness,shn,ao,id,wrapP);
    color amb;
    if(Mode==0) amb=Ambient(n)*albedo*ao*.80;
    else { float up=sat01(n[1]*.5+.5); amb=Ambient(n)*mix(albedo,Deep(albedo),.40)*ao*mix(.58,.98,up*up)*mix(.80,1.0,sqrt(ndv)); }
    col+=albedo*knit*pow(1-ndv,5)*.045*sat01(dot(n,LKey()))*CKey();
    float rim=pow(1-ndv,3.5)*.025;
    color rimLight=color(1,.92,.75)*rim*sat01(dot(n,LKey())*.7+.3)*(0.35+0.65*albedo)*CKey();
    col+=amb+rimLight;
    float neutralWhite=smoothstepf(.4,.8,luma(albedo));
    float gain=1.05;
    col*=mix(gain,1,m3[2]);
    col*=mix(.68,1,aoVis)*mix(Mode==0?.92:.95,1,m3[1]);
    Out=emission()*col;
}
